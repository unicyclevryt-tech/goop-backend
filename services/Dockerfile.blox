FROM oven/bun:1
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates nodejs && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN git clone --depth=1 https://github.com/x8rr/webblox-built.git . && bun install
# Downloads official engine files at first startup; they are large and may require Roblox access.
CMD ["sh","-c","bun run fetch:webblox && bun start"]
